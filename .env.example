# "local" enables the unauthenticated dev smoke route. Never set it on a server.
APP_ENV=local

# FinancePro (test environment)
FINPRO_AUTH_BASE=https://auth-api-test.finance-pro.com.au
FINPRO_BROKER_BASE=https://broker-api-test.finance-pro.com.au
FINPRO_INVESTOR_BASE=https://investor-api-test.finance-pro.com.au
FINPRO_APP_ID=finpro-crm-client
# Keep the real secret only in your local/server .env. Never commit it.
FINPRO_APP_SECRET=

# CRM database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm
DB_USER=crm
DB_PASS=change-me

# CRM JWT signing key (generate: openssl rand -hex 32)
JWT_SECRET=
